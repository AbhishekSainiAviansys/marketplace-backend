APP_NAME=Marketplace
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8001

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# XAMPP MariaDB 10.4 -> keep utf8mb4_unicode_ci (do NOT use utf8mb4_0900_ai_ci)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=marketplace_local
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# file drivers -> no cache/sessions/jobs tables required in DB
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Local mail: Mailpit (docs/OTP-MAIL.md). If Mailpit is not running the OTP
# endpoint still returns otp_debug because APP_DEBUG=true.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=noreply@market.local
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Consolidated SPA: one Vite dev server (:5173) + Laravel API (:8001). Auth is a
# Sanctum Bearer token (no cookies), so this list only needs the dev origin.
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173

# UI origins (used by mail links / future redirects). Panels are path-based.
FRONTEND_ADMIN_URL=http://localhost:5173/admin
FRONTEND_VENDOR_URL=http://localhost:5173/vendor
FRONTEND_SCHOOL_URL=http://localhost:5173/school

VITE_APP_NAME="${APP_NAME}"
