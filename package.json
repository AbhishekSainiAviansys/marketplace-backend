{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "concurrently \"php artisan serve --port=8000\" \"vite\"",
        "dev:api": "php artisan serve --port=8000",
        "dev:ui": "vite",
        "build": "cross-env NODE_OPTIONS=--max-old-space-size=6144 tsc -b && cross-env NODE_OPTIONS=--max-old-space-size=6144 vite build"
    },
    "dependencies": {
        "axios": "^1.20.0",
        "lucide-react": "1.52.0",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "react-router-dom": "^7.18.4"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.3.3",
        "@types/node": "^24.19.1",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.1",
        "concurrently": "^10.0.6",
        "cross-env": "^10.1.0",
        "laravel-vite-plugin": "^3.1",
        "tailwindcss": "^4.3.3",
        "typescript": "~6.0.3",
        "vite": "^8.3.2"
    }
}
